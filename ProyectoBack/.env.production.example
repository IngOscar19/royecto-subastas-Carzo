# Configuración de Producción para Despliegue en Railway / Render / Fly.io

# Puerto en el servidor
PORT=3000

# CORS Origins (separa múltiples orígenes por coma, o '*' para permitir clientes móviles)
CORS_ORIGIN=*

# PostgreSQL Gestionado (ej. Neon, Railway Postgres, Render Postgres)
DB_HOST=tu-postgres-host.railway.app
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=tu_password_seguro_produccion
DB_NAME=subastas_db
DB_SSL=true

# Redis Gestionado (ej. Upstash, Railway Redis, Render Redis)
REDIS_HOST=tu-redis-host.railway.app
REDIS_PORT=6379
REDIS_PASSWORD=tu_password_redis

# Autenticación JWT (Rotado para Producción)
JWT_SECRET=super_secret_jwt_key_production_rotated_2026_x98z
JWT_EXPIRES_IN=7d
